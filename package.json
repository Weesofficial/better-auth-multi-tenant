{
  "name": "better-auth-multi-tenant",
  "version": "0.4.0",
  "description": "Subdomain-based multi-tenancy for Better Auth: tenant resolution from the request host, tenant-bound sessions, and cross-tenant request rejection.",
  "keywords": [
    "better-auth",
    "better-auth-plugin",
    "multi-tenant",
    "multi-tenancy",
    "subdomain",
    "tenant-isolation",
    "saas",
    "auth"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Weesofficial/better-auth-multi-tenant.git"
  },
  "homepage": "https://github.com/Weesofficial/better-auth-multi-tenant#readme",
  "bugs": {
    "url": "https://github.com/Weesofficial/better-auth-multi-tenant/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "better-auth": ">=1.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "better-auth": "^1.7.12",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20.19"
  }
}
