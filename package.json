{
  "name": "better-auth-multi-tenant",
  "version": "0.7.0",
  "description": "Multi-tenancy for Better Auth by subdomain, custom domain or path: tenant resolution, tenant-bound sessions, and cross-tenant request rejection.",
  "keywords": [
    "better-auth",
    "better-auth-plugin",
    "multi-tenant",
    "multi-tenancy",
    "subdomain",
    "path-based",
    "custom-domain",
    "tenant-isolation",
    "saas",
    "auth"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Weesofficial/better-auth-multi-tenant.git"
  },
  "homepage": "https://github.com/Weesofficial/better-auth-multi-tenant#readme",
  "bugs": {
    "url": "https://github.com/Weesofficial/better-auth-multi-tenant/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    }
  },
  "scripts": {
    "build": "tsup && npm run check:edge",
    "check:edge": "node --import tsx scripts/edge-check.ts dist/index.js dist/client.js dist/react.js",
    "pack:examples": "npm run build && rm -rf examples/.pack && mkdir -p examples/.pack && npm pack --pack-destination examples/.pack --silent && mv examples/.pack/*.tgz examples/.pack/better-auth-multi-tenant.tgz",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "@better-auth/core": ">=1.6.0",
    "@better-auth/sso": ">=1.6.0",
    "better-auth": ">=1.6.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@better-auth/api-key": "^1.7.14",
    "@better-auth/passkey": "^1.7.14",
    "@better-auth/sso": "^1.7.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "better-auth": "^1.7.14",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20.19"
  },
  "peerDependenciesMeta": {
    "@better-auth/sso": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@better-auth/core": {
      "optional": true
    }
  }
}
